{% comment %}
  BRAIN Lab look & feel. Every page starts with {% include brain_style.liquid %}.
  Palette: navy #101D35 · blue #2563EB · teal #14B8A6 · slate #64748B · soft white #F8FAFC
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap">
<style>
  :root, html[data-theme="light"] {
    --global-theme-color: #2563eb;
    --global-hover-color: #1d4ed8;
    --global-bg-color: #f8fafc;
    --b-navy: #101d35;
    --b-blue: #2563eb;
    --b-teal: #14b8a6;
    --b-slate: #64748b;
    --b-ink: #0f172a;
    --b-line: #e2e8f0;
    --b-paper: #ffffff;
    --b-tint: #eef4ff;
  }
  html[data-theme="dark"] {
    --global-theme-color: #60a5fa;
    --global-hover-color: #93c5fd;
    --b-navy: #0b1426;
    --b-blue: #60a5fa;
    --b-teal: #2dd4bf;
    --b-slate: #94a3b8;
    --b-ink: #e2e8f0;
    --b-line: #1e293b;
    --b-paper: #111c30;
    --b-tint: #13213a;
  }
  body, .navbar, p, li, td, th, input, button { font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif !important; }
  h1, h2, h3, h4, .post-title, .navbar-brand, .b-display { font-family: "Space Grotesk", "Inter", sans-serif !important; letter-spacing: -0.015em; color: var(--b-ink); }
  .navbar .nav-link { font-weight: 500; font-size: 0.93rem; }
  .post-title { font-weight: 700 !important; }
  .post-header .desc, .post-description { color: var(--b-slate) !important; font-size: 1rem; }
  .post h2 { font-weight: 600; font-size: 1.6rem; margin: 2.6rem 0 1rem; }
  .post h3 { font-weight: 600; font-size: 1.15rem; }
  .post a { text-decoration: none; }
  .b-eyebrow { font-family: "Space Grotesk", sans-serif; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--b-teal); }
  .b-muted { color: var(--b-slate); }
  .b-lead { font-size: 1.12rem; line-height: 1.7; color: var(--b-slate); max-width: 46rem; }

  /* Home hero */
  .b-hero { position: relative; overflow: hidden; border-radius: 20px; background: radial-gradient(120% 140% at 85% 10%, #1e3a8a 0%, var(--b-navy) 55%); color: #e2e8f0; padding: clamp(2rem, 5vw, 3.6rem) clamp(1.4rem, 4vw, 3.2rem); margin: 0.5rem 0 2.5rem; }
  .b-hero svg.b-net { position: absolute; right: -40px; top: -20px; width: 60%; height: 120%; opacity: 0.55; pointer-events: none; }
  .b-hero > * { position: relative; }
  .b-hero .b-brand { font-family: "Space Grotesk", sans-serif; font-weight: 700; font-size: 1.05rem; letter-spacing: 0.22em; color: #fff; }
  .b-hero .b-brand small { display: block; font-family: "Inter", sans-serif; font-weight: 400; letter-spacing: 0.02em; font-size: 0.82rem; color: #94a3b8; margin-top: 0.2rem; }
  .b-hero h1 { color: #fff; font-size: clamp(2rem, 4.6vw, 3.1rem); line-height: 1.08; font-weight: 700; margin: 1.6rem 0 1rem; max-width: 34rem; }
  .b-hero h1 span { background: linear-gradient(90deg, #60a5fa, #2dd4bf); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .b-hero p { color: #cbd5e1; max-width: 33rem; font-size: 1.05rem; line-height: 1.65; }
  .b-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.6rem; }
  .b-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.7rem 1.25rem; border-radius: 10px; font-weight: 600; font-size: 0.94rem; transition: all .15s ease; }
  .b-btn.solid { background: var(--b-blue); color: #fff !important; }
  .b-btn.solid:hover { background: #1d4ed8; }
  .b-btn.ghost { border: 1px solid rgba(255,255,255,.28); color: #fff !important; }
  .b-btn.ghost:hover { background: rgba(255,255,255,.08); }
  .b-stats { display: flex; flex-wrap: wrap; gap: 2.4rem; margin-top: 2.4rem; padding-top: 1.6rem; border-top: 1px solid rgba(255,255,255,.12); }
  .b-stats div { font-family: "Space Grotesk", sans-serif; font-size: 1.9rem; font-weight: 700; color: #fff; line-height: 1; }
  .b-stats span { display: block; font-family: "Inter", sans-serif; font-size: 0.78rem; font-weight: 500; color: #94a3b8; margin-top: 0.4rem; letter-spacing: .04em; }
  .b-note { font-size: 0.75rem; color: #64748b; margin-top: 0.9rem; }

  /* Two-column intro */
  .b-split { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  @media (max-width: 760px) { .b-split { grid-template-columns: 1fr; gap: 1rem; } }

  /* Numbered research list */
  .b-areas { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); border-top: 1px solid var(--b-line); border-left: 1px solid var(--b-line); margin: 1.2rem 0 2rem; }
  .b-area { padding: 1.4rem 1.4rem 1.5rem; border-right: 1px solid var(--b-line); border-bottom: 1px solid var(--b-line); background: var(--b-paper); transition: background .15s ease; display: block; }
  .b-area:hover { background: var(--b-tint); }
  .b-area .n { font-family: "Space Grotesk", sans-serif; font-size: 0.8rem; color: var(--b-slate); }
  .b-area i { float: right; font-size: 1.2rem; color: var(--b-blue); }
  .b-area h3 { margin: 0.9rem 0 0.45rem; font-size: 1.08rem; }
  .b-area p { margin: 0; font-size: 0.92rem; color: var(--b-slate); line-height: 1.55; }

  /* Research detail rows */
  .b-row { display: grid; grid-template-columns: 64px 1fr; gap: 1.2rem; padding: 1.8rem 0; border-bottom: 1px solid var(--b-line); }
  .b-row:first-of-type { border-top: 1px solid var(--b-line); }
  .b-row .ic { width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; color: #fff; background: linear-gradient(135deg, var(--b-blue), var(--b-teal)); }
  .b-row h3 { margin: 0 0 0.5rem; }
  .b-row p { margin: 0; color: var(--b-slate); line-height: 1.65; }
  .b-kw { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.8rem; }
  .b-kw span { font-size: 0.74rem; font-weight: 500; padding: 0.2rem 0.6rem; border-radius: 6px; background: var(--b-tint); color: var(--b-blue); }

  /* Feature panels (projects) */
  .b-feature { display: grid; grid-template-columns: 1fr 240px; border: 1px solid var(--b-line); border-radius: 16px; overflow: hidden; background: var(--b-paper); margin: 1.2rem 0 1.6rem; }
  .b-feature .body { padding: 1.6rem 1.8rem; }
  .b-feature .body h3 { font-size: 1.3rem; margin: 0.5rem 0 0.8rem; }
  .b-feature .body p { color: var(--b-slate); line-height: 1.65; }
  .b-feature aside { background: var(--b-tint); padding: 1.6rem 1.4rem; font-size: 0.88rem; }
  .b-feature aside dt { font-size: 0.7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--b-slate); font-weight: 600; margin-top: 0.9rem; }
  .b-feature aside dt:first-child { margin-top: 0; }
  .b-feature aside dd { margin: 0.15rem 0 0; font-weight: 600; color: var(--b-ink); }
  @media (max-width: 760px) { .b-feature { grid-template-columns: 1fr; } }
  .b-status { display: inline-block; font-size: 0.7rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; padding: 0.22rem 0.6rem; border-radius: 6px; background: rgba(20,184,166,.14); color: var(--b-teal); }
  .b-links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; font-weight: 600; font-size: 0.92rem; }

  /* Simple list rows (ongoing projects, resources) */
  .b-list > div { padding: 1.1rem 0; border-bottom: 1px solid var(--b-line); }
  .b-list > div:first-child { border-top: 1px solid var(--b-line); }
  .b-list .meta { font-size: 0.78rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--b-teal); }
  .b-list h4 { font-size: 1.02rem; margin: 0.3rem 0; font-family: "Inter", sans-serif !important; font-weight: 600; }
  .b-list p { margin: 0; color: var(--b-slate); font-size: 0.93rem; }
  .b-list .sub { font-size: 0.82rem; color: var(--b-slate); margin-top: 0.35rem; }

  /* Tables */
  .post table { font-size: 0.9rem; border-collapse: collapse; width: 100%; }
  .post table th { font-family: "Space Grotesk", sans-serif; font-weight: 600; color: var(--b-ink); border-bottom: 2px solid var(--b-line); text-align: left; padding: 0.6rem 0.5rem; }
  .post table td { border-bottom: 1px solid var(--b-line); padding: 0.6rem 0.5rem; vertical-align: top; }

  /* Publications */
  .b-filter { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 0.5rem; }
  .b-filter button { border: 1px solid var(--b-line); background: var(--b-paper); color: var(--b-ink); border-radius: 999px; padding: 0.35rem 0.9rem; font-size: 0.85rem; font-weight: 500; cursor: pointer; }
  .b-filter button.on { background: var(--b-navy); color: #fff; border-color: var(--b-navy); }
  .b-year { display: grid; grid-template-columns: 90px 1fr; gap: 1rem; border-top: 1px solid var(--b-line); padding-top: 1rem; margin-top: 1.4rem; }
  .b-year > .y { font-family: "Space Grotesk", sans-serif; font-size: 1.6rem; font-weight: 700; color: var(--b-ink); position: sticky; top: 70px; align-self: start; }
  @media (max-width: 640px) { .b-year { grid-template-columns: 1fr; } .b-year > .y { position: static; } }
  .b-pub { padding: 0.2rem 0 1.1rem; }
  .b-pub .t { font-weight: 600; color: var(--b-ink); line-height: 1.45; }
  .b-pub .a { font-size: 0.88rem; color: var(--b-slate); margin-top: 0.2rem; }
  .b-pub .a b { color: var(--b-ink); font-weight: 600; }
  .b-pub .v { font-size: 0.86rem; margin-top: 0.25rem; }
  .b-pub .v em { color: var(--b-ink); }
  .b-pub .type { font-size: 0.66rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; padding: 0.12rem 0.45rem; border-radius: 4px; margin-right: 0.45rem; vertical-align: 1px; }
  .type.journal { background: rgba(37,99,235,.12); color: var(--b-blue); }
  .type.conference { background: rgba(20,184,166,.14); color: var(--b-teal); }
  .type.other { background: rgba(100,116,139,.15); color: var(--b-slate); }
  .b-pub .v a { margin-left: 0.6rem; font-weight: 600; }

  /* People */
  .b-pi { display: grid; grid-template-columns: 220px 1fr; gap: 2.2rem; margin: 1rem 0 2rem; }
  @media (max-width: 760px) { .b-pi { grid-template-columns: 1fr; } }
  .b-pi img, .b-member img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 16px; background: var(--b-tint); }
  .b-pi h3 { font-size: 1.6rem; margin: 0.2rem 0 0.3rem; }
  .b-pi .roles { color: var(--b-slate); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1rem; }
  .b-pi p { line-height: 1.7; }
  .b-icons { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .b-icons a { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; font-weight: 600; padding: 0.35rem 0.75rem; border: 1px solid var(--b-line); border-radius: 8px; color: var(--b-ink) !important; }
  .b-icons a:hover { border-color: var(--b-blue); color: var(--b-blue) !important; }
  .b-metrics { display: flex; gap: 2rem; margin: 1.2rem 0 0.3rem; }
  .b-metrics div { font-family: "Space Grotesk", sans-serif; font-size: 1.5rem; font-weight: 700; color: var(--b-blue); line-height: 1; }
  .b-metrics span { display: block; font-family: "Inter", sans-serif; font-size: 0.75rem; color: var(--b-slate); font-weight: 500; margin-top: 0.3rem; }
  .b-team { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 1.4rem; margin: 0.8rem 0 1.5rem; }
  .b-member .name { font-weight: 600; margin-top: 0.7rem; color: var(--b-ink); }
  .b-member .role { font-size: 0.85rem; color: var(--b-slate); }
  .b-details summary { cursor: pointer; font-weight: 600; color: var(--b-blue); margin-top: 1rem; }

  /* News timeline */
  .b-timeline { border-left: 2px solid var(--b-line); margin: 1.4rem 0 1rem 0.4rem; padding-left: 1.6rem; }
  .b-timeline > div { position: relative; padding-bottom: 2rem; }
  .b-timeline > div::before { content: ""; position: absolute; left: calc(-1.6rem - 7px); top: 0.35rem; width: 12px; height: 12px; border-radius: 50%; background: var(--b-paper); border: 3px solid var(--b-blue); }
  .b-timeline h3 { margin: 0.35rem 0 0.5rem; font-size: 1.15rem; }
  .b-timeline p { color: var(--b-slate); margin: 0 0 0.4rem; line-height: 1.65; }

  /* Contact */
  .b-contact { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2rem; margin-top: 1rem; }
  @media (max-width: 760px) { .b-contact { grid-template-columns: 1fr; } }
  .b-card { border: 1px solid var(--b-line); border-radius: 16px; padding: 1.6rem; background: var(--b-paper); }
  .b-card p { line-height: 1.7; }
</style>
